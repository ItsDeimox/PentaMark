{
  "name": "pentamark",
  "version": "2.13.21",
  "description": "Editor Markdown local e compartilhado",
  "author": "PentaMark",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "check": "npm run typecheck && npm run local:build",
    "test:unit": "node --test tests/inline-source-map.test.mjs tests/live-block-scanner.test.mjs tests/table-source.test.mjs tests/android-transport.test.mjs tests/remote-profile.test.mjs tests/graphics-policy.test.mjs tests/graphics-renderers.test.mjs tests/invitation.test.mjs tests/tailscale-invites.test.mjs tests/desktop-updater.test.mjs tests/desktop-data-root.test.mjs",
    "mcp:build": "esbuild ./local/mcp-bridge.source.mjs --bundle --platform=node --format=esm --outfile=./local/mcp-bridge.mjs",
    "local:build": "npm run mcp:build && vite build --outDir local-dist --emptyOutDir",
    "mobile:bundle": "npm run local:build && node ./scripts/build-mobile-host.mjs",
    "android:sync": "npm run local:build && cap sync android",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "npm run local:build && electron .",
    "desktop:build": "npm run local:build && electron-builder --win portable --x64",
    "desktop:dir": "npm run local:build && electron-builder --dir"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/chakra-petch": "5.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^7.0.0",
    "dompurify": "3.2.6",
    "highlight.js": "11.11.1",
    "lucide-react": "0.468.0",
    "marked": "15.0.12",
    "mermaid": "^11.16.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.56.1",
    "@types/dompurify": "3.0.5",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "com.pentamark.desktop",
    "productName": "PentaMark",
    "asar": true,
    "electronLanguages": [
      "en-US",
      "pt-BR"
    ],
    "directories": {
      "output": "desktop-dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/sync-ipc.cjs",
      "desktop/splash.html",
      "public/pentamark-brand.svg",
      "public/pentamark-brand-badge.svg",
      "desktop/tailscale.cjs",
      "desktop/updater.cjs",
      "desktop/invitations.cjs",
      "desktop/apply-update.ps1",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "local",
        "to": "local"
      },
      {
        "from": "local-dist",
        "to": "local-dist"
      }
    ],
    "win": {
      "icon": "build/pentamark.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PentaMark-Desktop-${version}-Windows.${ext}"
    },
    "portable": { "splashImage": "build/splash.bmp" }
  }
}
